  "scripts": {
    "dsh:prepare": "node scripts/dsh-artifacts.mjs",
    "dsh:lock": "node scripts/dsh-artifacts.mjs --update-lock",
    "build": "node scripts/build.mjs",
    "start": "node dist/app/AiHost/main.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "node scripts/dev.mjs --mobile",
    "release": "dotnet run --project tools/release --",
    "build:app": "dotnet build Facade/HeronAI.App/HeronAI.App.csproj -c Release",
    "build:all": "npm run build && npm run build:app",
    "test": "node --test \"tests/*.test.mjs\" \"packages/common/**/tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.5",
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
