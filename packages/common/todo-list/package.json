{
  "name": "@common/todo-list",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "个人待办：右侧栏「待办」面板，数据只保存在当前实例的 stateDir，经 owner 路由读写；面板打开时为当前聊天 Agent 提供 todo_list 等工具",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@common/capabilities": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
