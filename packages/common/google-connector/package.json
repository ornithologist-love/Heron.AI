{
  "name": "dsh-google-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Connect a local Heron.AI profile to Google Workspace",
  "main": "./index.mjs",
  "files": ["*.mjs", "client.js", "cordis.patch.yml", "README.md"],
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
