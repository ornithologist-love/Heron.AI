<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HeronAI.Facade"
             x:Class="HeronAI.Facade.AiDiagnosticsPanel"
             x:DataType="local:AiDiagnosticsPanelModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{Binding Status}" Classes="textBody" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="重启 AI" Classes="contentButton buttonSecondary buttonSmall"
                        Command="{Binding RestartCommand}" AutomationProperties.Name="重启 AI"/>
                <Button Content="热更新" Classes="contentButton buttonPrimary buttonSmall"
                        Command="{Binding HotReloadCommand}" AutomationProperties.Name="AI 热更新"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Classes="textSecondary" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2" Spacing="4">
            <CheckBox Content="插件开发 HMR" IsChecked="{Binding DevelopmentHmrEnabled, Mode=TwoWay}"
                      IsEnabled="{Binding CanConfigureDevelopmentHmr}" AutomationProperties.Name="插件开发 HMR"/>
            <TextBlock Text="{Binding DevelopmentHmrHint}" Classes="textSecondary" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="运行日志" Classes="textBody" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1" Content="自动滚动" IsChecked="{Binding FollowOutput}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="清空日志" Classes="contentButton buttonQuiet buttonSmall" Command="{Binding ClearCommand}"/>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding LogText}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                         Foreground="{DynamicResource FgDefaultBrush}"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
